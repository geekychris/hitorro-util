    <build>
        <outputDirectory>target/scala-${scala.binary.version}/classes</outputDirectory>
        <testOutputDirectory>target/scala-${scala.binary.version}/test-classes</testOutputDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <optimize>true</optimize>
                    <encoding>UTF-8</encoding>
                    <maxmem>512m</maxmem>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <HT_HOME>${session.executionRootDirectory}</HT_HOME>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Sync type configs and schemas from hitorro-util to the root config directory.
                 hitorro-util/config/ is the source of truth for core types and JSON schemas.
                 The root config/ directory is the runtime location used by Env.getBinConfigBaseFile(). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>sync-type-schemas</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${hitorro.runtime.config.dir}/schemas</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>config/schemas</directory>
                                    <includes>
                                        <include>*.schema.json</include>
                                    </includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sync-core-type-configs</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${hitorro.runtime.config.dir}/types</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>config/types</directory>
                                    <includes>
                                        <include>core_*.json</include>
                                    </includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sync-implementations-config</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${hitorro.runtime.config.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>config</directory>
                                    <includes>
                                        <include>implementations.json</include>
                                    </includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sync-transforms</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${hitorro.runtime.config.dir}/transforms</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>config/transforms</directory>
                                    <includes>
                                        <include>*.groovy</include>
                                    </includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sync-generators</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${hitorro.runtime.config.dir}/generators</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>config/generators</directory>
                                    <includes>
                                        <include>*.csv</include>
                                    </includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>hitorro-local</id>
            <name>Hitorro Local Maven Repository</name>
            <url>file://${hitorro.deploy.repo.path}</url>
        </repository>
        <snapshotRepository>
            <id>hitorro-local-snapshots</id>
            <name>Hitorro Local Maven Snapshot Repository</name>
            <url>file://${hitorro.deploy.repo.path}</url>
        </snapshotRepository>
    </distributionManagement>

</project>
